{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window and any spawned child windows",
  "windows": ["main", "inkling-*"],
  "permissions": [
    "core:default",
    "core:window:allow-create",
    "core:webview:allow-create-webview-window",
    "opener:default",
    "dialog:allow-open",
    "dialog:allow-save"
  ]
}
