{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window and any spawned child windows",
  "windows": ["main", "inkling-*"],
  "permissions": [
    "core:default",
    "core:window:allow-create",
    "core:webview:allow-create-webview-window",
    "opener:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "allow-list-dir",
    "allow-read-text-file",
    "allow-write-text-file",
    "allow-write-binary-file",
    "allow-file-mtime",
    "allow-rename-path",
    "allow-delete-path",
    "allow-create-file",
    "allow-create-dir",
    "allow-search-in-workspace",
    "allow-pandoc-check",
    "allow-pandoc-export-docx",
    "allow-take-pending-file"
  ]
}
